{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TURBZHACK",
  "version": "0.1.0",
  "identifier": "com.turbz.turbzhack",
  "build": {
    "frontendDist": "../dist-web"
  },
  "app": {
    "windows": [
      {
        "title": "TURBZHACK",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 560,
        "resizable": true,
        "label": "main"
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}