{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TURBZHACK",
  "version": "0.1.0",
  "identifier": "com.turbz.turbzhack",
  "build": {
    "frontendDist": "../"
  },
  "app": {
    "windows": [
      {
        "title": "TURBZHACK",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": ["content/**/*", "assets/**/*", "dist/**/*"]
  }
}
